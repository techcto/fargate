{
  "version": 1,
  "name": "Fargate App Hub",
  "engine": "fargate",
  "lifecycle": "cloudformation-change-set",
  "requiredPlatformOutputs": [
    "Cluster",
    "ClusterArn",
    "VpcId"
  ],
  "applicationParameters": {
    "Cluster": "Cluster",
    "ClusterArn": "ClusterArn",
    "VpcId": "VpcId"
  },
  "customerInputs": [
    "privateServiceSubnets",
    "hostname",
    "certificateArn"
  ],
  "ownership": {
    "platform": [
      "cluster",
      "loadBalancer",
      "listeners"
    ],
    "application": [
      "services",
      "taskRoles",
      "securityGroups",
      "targetGroups",
      "listenerRules",
      "storage"
    ],
    "database": "Optional shared Aurora MySQL owned by the platform; each application owns its isolated database allocation and secret. Allocation deletion preserves data."
  },
  "cloudIntegrationStatus": "adapter-required",
  "optionalPlatformOutputs": {
    "http": [
      "ListenerArn",
      "LoadBalancerSecurityGroup"
    ],
    "mysql": [
      "DatabaseClusterArn",
      "DatabaseEndpoint",
      "DatabaseSecurityGroup",
      "TenantDatabaseProviderArn",
      "PlatformStackName",
      "PlatformStackId"
    ],
    "documentdb": [
      "DocumentDbArn",
      "DocumentDbEndpoint",
      "DocumentDbSecurityGroup"
    ],
    "filesystem": [
      "EfsFileSystemId",
      "EfsSecurityGroup"
    ],
    "cache": [
      "RedisArn",
      "RedisHost",
      "RedisSecurityGroup",
      "RedisUserGroupId"
    ],
    "backup": [
      "BackupPlanId",
      "BackupVaultName"
    ],
    "usage": [
      "TaskEventsLogGroup"
    ]
  }
}
